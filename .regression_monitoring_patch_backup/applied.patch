+import json
+from types import SimpleNamespace
+
+import numpy as np
+import pandas as pd
+import pytest
+
+from ml_template.monitoring.nullable_drift import nullable_profile, nullable_compare
+from ml_template.monitoring.regression import (
+    evaluate_predictions, findings, validate_options, validate_outcomes, validate_predictions,
+)
+
+
+def data():
+    predictions = pd.DataFrame({"id": [3, 1, 2, 4],
+                                "y_pred_raw": [7., -2., 3., 10.],
+                                "y_pred_release": [7., -2., 3., 10.]})
+    labels = pd.DataFrame({"id": [1, 2, 3, 4], "y_true": [-1.5, 2.25, 8.5, None],
+                           "observed_at": ["2026-01-01T00:00:00Z"] * 3 + [None],
+                           "eligible_at": ["2026-01-01T00:00:00Z"] * 4})
+    return predictions, labels
+
+
+def evaluate(p, y, **kwargs):
+    return evaluate_predictions(p, y, "id", as_of="2026-01-02T00:00:00Z",
+                                min_labelled=2, **kwargs)
+
+
+def config(**overrides):
+    values = dict(min_rows=2, min_labelled=2, min_label_coverage=0.9,
+                  js_warning=0.1, missing_rate_warning=0.2, missing_rate_delta_warning=0.1,
+                  target_unit="target_units", rmse_warning=0.1, mae_warning=None,
+                  abs_bias_warning=None, brier_warning=None, recall_floor=None)
+    values.update(overrides)
+    return SimpleNamespace(**values)
+
