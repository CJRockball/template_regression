+"""Synthetic real-Parquet integration. No model checkpoint exists or is loaded."""
+import hashlib
+import json
+import sqlite3
+from pathlib import Path
+
+import numpy as np
+import pandas as pd
+import pytest
+
+
+@pytest.fixture
+def stored(tmp_path, monkeypatch):
+    pytest.importorskip("pyarrow")
+    from ml_template.dashboard import regression_data as base
+    from ml_template.evaluation.residual_analysis_run import ResidualConfig, split_identity
+    from ml_template.tracking.run_artifacts import write_artifact_manifest
+    run = tmp_path / "runs/run_test"
+    run.mkdir(parents=True)
+    silver = tmp_path / "silver/test/silver_test"
+    silver.mkdir(parents=True)
+    splits = tmp_path / "splits"
+    out = tmp_path / "analyses"
+    monkeypatch.setenv("ML_TEMPLATE_ANALYSIS_ROOT", str(out))
+    contract = tmp_path / "contract.yaml"
+    contract.write_text(
+        "data: {task: regression, entity_id: id, target: y}\n"
+        "bronze_source_contract:\n  roles: {id: [id], feature: [x], target: [y]}\n"
+        "silver_eda_contract:\n  canonical_names: {id: id, x: x, y: y}\n"
+        "  canonical_dtypes: {id: int64, x: float64, y: float64}\n")
+    policy = {"method": "random", "n_folds": 2, "holdout_fraction": .2, "seed": 42,
+              "calibration_fraction": .1, "recalibration_fraction": .1}
+    split_id = split_identity("silver_test", policy, "id", "y")
+    cfg = {"schema_version": 2, "task": "regression", "experiment_name": "synthetic_nn",
+           "seed": 42, "data": {"dataset_name": "test", "dataset_config": str(contract),
+           "silver_dataset_version_id": "silver_test", "feature_set_id": None},
+           "split": {**policy, "cv_seed": None}, "analysis": {}, "fitted_features": None,
+           "model": {"type": "nn", "params": {"task": "regression"}},
+           "metrics": {"primary": "rmse", "names": ["rmse", "mae", "r2"], "alert_rates": []}}
+    assignments = pd.DataFrame({"id": range(10), "partition": ["dev"] * 6 + ["holdout"] * 2 + ["calibration", "recalibration"],
+                                "fold": [0, 1, 0, 1, 0, 1, -1, -1, -1, -1]})
+    split_dir = splits / split_id
+    split_dir.mkdir(parents=True)
+    assignments.to_parquet(split_dir / "assignments.parquet", index=False)
+    split_manifest = {"split_id": split_id, "silver_dataset_version_id": "silver_test", "policy": policy,
+                      "key_col": "id", "target_col": "y", "n_rows": 10, "n_holdout": 2,
+                      "n_calibration": 1, "n_recalibration": 1, "fold_sizes": {"0": 3, "1": 3},
+                      "assignments_sha256": hashlib.sha256(assignments.to_csv(index=False).encode()).hexdigest()}
+    (split_dir / "manifest.json").write_text(json.dumps(split_manifest))
+    data = pd.DataFrame({"id": range(10), "x": np.arange(10, dtype=float),
+                         "y": [float(k) + .5 for k in range(6)] + [np.inf, np.nan, np.inf, np.nan]})
+    data.to_parquet(silver / "data.parquet", index=False)
+    sm = {"validation_passed": True, "silver_dataset_version_id": "silver_test",
+          "roles": {"id": ["id"], "feature": ["x"], "target": ["y"]},
+          "config_sha256": base.sha256(contract), "parquet_sha256": base.sha256(silver / "data.parquet")}
+    (silver / "manifest.json").write_text(json.dumps(sm))
+    (run / "config.json").write_text(json.dumps(cfg))
+    (run / "features.json").write_text(json.dumps({"silver_dataset_version_id": "silver_test", "split_id": split_id,
+                                                   "features": ["x"], "dtypes": {"x": "float64"}}))
+    pd.DataFrame({"id": range(6), "fold": [0, 1, 0, 1, 0, 1],
+                  "y_pred_oof": [float(k) + .25 for k in range(6)]}).to_parquet(run / "oof_predictions.parquet", index=False)
+    write_artifact_manifest(run)
+    db = tmp_path / "project.db"
+    c = sqlite3.connect(db)
+    c.execute("CREATE TABLE model_runs (run_id TEXT, status TEXT, artifact_dir TEXT, config_hash TEXT, silver_dataset_version_id TEXT, feature_set_id TEXT, split_id TEXT, seed INTEGER, model_type TEXT)")
+    c.execute("INSERT INTO model_runs VALUES (?,?,?,?,?,?,?,?,?)", ("run_test", "succeeded", str(run), base.snapshot_hash(cfg), "silver_test", None, split_id, 42, "nn"))
