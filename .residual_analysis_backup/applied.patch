+"""Pure residual summaries, config and partition integrity tests."""
+import copy
+import hashlib
+from types import SimpleNamespace
+
+import numpy as np
+import pandas as pd
+import pytest
+
+from ml_template.evaluation.residual_artifacts import augment_summary, check_keys, statistics
+from ml_template.evaluation.residual_analysis_run import ResidualConfig, split_identity, validate_inventory
+
+
+def inventory():
+    a = pd.DataFrame({"id": range(8), "partition": ["dev"] * 4 + ["holdout"] * 2 + ["calibration", "recalibration"],
+                      "fold": [0, 1, 0, 1, -1, -1, -1, -1]})
+    o = pd.DataFrame({"id": [0, 1, 2, 3], "fold": [0, 1, 0, 1], "y_pred_oof": [.2, 1.2, 2.2, 3.2]})
+    m = {"n_rows": 8, "n_holdout": 2, "n_calibration": 1, "n_recalibration": 1,
+         "fold_sizes": {"0": 2, "1": 2},
+         "assignments_sha256": hashlib.sha256(a.to_csv(index=False).encode()).hexdigest()}
+    return a, o, m
+
+
+def test_known_signed_residual_statistics():
+    s = statistics(pd.DataFrame({"y_true": [1., 3., 5.], "y_pred_oof": [0., 5., 4.]}))
