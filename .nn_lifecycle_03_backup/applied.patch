+    metrics = [{'variant': cfg['release_variant'], 'metric': k, 'value': v, 'direction': direction, 'status': 'defined', 'uncertainty': 'not_requested'} for k, v, direction in [('rmse', 1.0, 'min'), ('mae', 1.0, 'min'), ('r2', -0.5, 'max')]]
+    if method is not None:
