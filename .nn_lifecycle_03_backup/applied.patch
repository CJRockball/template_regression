+    data = {'summary': summary, 'spec': cfg, 'provenance': p, 'metrics': metrics, 'acceptance': {'status': 'not_assessed', 'results': [], 'automatic_promotion': False}, 'residual_summary': {'mean': 1 / 3}, 'prior_exposures': []}
+    record = {'status': 'succeeded', 'accessed_at': 'recorded', 'evaluation_id': 'eval_test', 'parent_run_id': 'run_test', 'identity_hash': identity, 'silver_id': 'silver_test', 'holdout_fingerprint': fp, 'calibration_id': cfg['calibration_id'], 'spec_json': json.dumps(cfg), 'prior_json': '[]'}
