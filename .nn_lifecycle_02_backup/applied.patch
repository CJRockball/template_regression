+    original_read = pd.read_parquet
+    def spy(path, *args, **kwargs):
+        if Path(path) == trained["parquet"]:
+            pytest.fail("support failure read source values")
+        return original_read(path, *args, **kwargs)
+    monkeypatch.setattr(pd, "read_parquet", spy)
+    monkeypatch.setattr(trained["torch"], "load", lambda *a, **k: pytest.fail("support failure loaded model"))
+    extra = {"min_calibration_rows": 100} if case == "minimum" else {"coverages": [.95]}
+    config = request_for(trained, **extra)
