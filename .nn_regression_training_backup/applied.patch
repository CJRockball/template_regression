+# Training/CV only. Existing concrete data are exploratory, not new untouched evidence.
+# Split fractions intentionally match the earlier patch-suite design; do not retrofit old runs.
+schema_version: 2
+task: regression
+experiment_name: concrete_nn_regression
+seed: 42
+data:
+  dataset_name: concrete
+  dataset_config: configs/bronze_silver_contract.yaml
+  silver_dataset_version_id: silver_concrete_v1_6fe40821
+  feature_set_id: null
+split:
+  method: random
+  holdout_fraction: 0.2
+  calibration_fraction: 0.15
+  recalibration_fraction: 0.1
+  n_folds: 5
+  seed: 42
+training:
+  validation_fraction: 0.2
+  refit_rounds_factor: 1.0
+metrics:
+  primary: rmse
+  names:
+  - rmse
+  - mae
+  - r2
+  alert_rates: []
+analysis:
+  permutation_importance: false
+  error_sample_size: 0
+  learning_curves: false
+  learning_curve_metric: rmse
+fitted_features: null
+model:
+  type: nn
+  params:
+    task: regression
+    loss: mse
+    architecture: mlp
+    hidden_dims:
+    - 64
+    - 32
+    dropout: 0.1
+    embedding_dropout: 0.0
+    max_epochs: 100
+    patience: 10
+    monitor: rmse
+    batch_size: 64
+    prediction_batch_size: 4096
+    learning_rate: 0.001
+    optimizer: adamw
+    weight_decay: 0.0001
+    gradient_clip_norm: 5.0
+    device: cpu
+    inference_device: cpu
+    cpu_threads: 1
+    deterministic: true
+    preprocessing:
+      numeric:
+      - cement
+      - blast_furnace_slag
+      - fly_ash
+      - water
+      - plasticizer
+      - coarse_aggregate
+      - fine_aggregate
+      - age
+      categorical: []
+      numeric_strategy: median
+      scaling: standard
