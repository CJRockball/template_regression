+    assert view['summary']['assessment_scope']['distribution_status'] == 'not_assessed_insufficient_rows'
+    assert view['summary']['target_unit'] == 'synthetic_units'
+    labels = pd.DataFrame({'id': prediction.id, 'scoring_batch_id': pipeline['scoring_batch_id'], 'y_true': prediction.y_pred_release.to_numpy() + np.array([0.0, 1.0, -1.0, 2.0]), 'observed_at': '2026-01-02T00:00:00+00:00', 'eligible_at': '2026-01-01T00:00:00+00:00'})
+    label_path = tmp_path / 'synthetic_labels.csv'
+    labels.to_csv(label_path, index=False)
