+        result = release_binding(summary, info, {'content_sha256': 'c' * 64}, record, release, {'predictions.parquet': {'sha256': 'b' * 64}}, 'd' * 64)
+        assert result['target_unit'] == 'MPa' and 'target_unit' not in summary and (result['nn_binding']['release']['evaluation_id'] == 'eval1')
