+    binding = {'schema_version': 1, 'release': release, 'score': {'scoring_batch_id': 'score1', 'input_sha256': 'a' * 64, 'n_rows': 4, 'predictions_sha256': sha(score / 'predictions.parquet'), 'artifacts_sha256': sha(score / 'artifacts.json')}}
+    input_sha = binding['score']['input_sha256']
+    if mode == 'raw':
+        prep = root / 'prepared'
+        prep.mkdir()
+        (prep / 'raw_input.csv').write_text('id,a\n1,2\n')
+        (prep / 'data.parquet').write_bytes(b'canonical fixture')
+        input_sha = sha(prep / 'raw_input.csv')
+        binding['score']['input_sha256'] = sha(prep / 'data.parquet')
+        (prep / 'manifest.json').write_text(json.dumps({'input_sha256': input_sha, 'release_id': release['release_id'], 'canonical_sha256': binding['score']['input_sha256']}))
+    state = {'pipeline_id': root.name, 'status': 'succeeded', 'stage': 'complete', 'predictions_computed': True, 'labels_loaded': False, 'evaluation_executed': False, 'release_built': False, 'task': 'regression', 'model_type': 'nn', 'release_id': release['release_id'], 'release_content_sha256': release['content_sha256'], 'target_unit': 'MPa', 'parent_run_id': 'run1', 'evaluation_id': 'eval1', 'calibration_id': None, 'release_variant': 'raw', 'interval_columns': {}, 'scoring_batch_id': 'score1', 'predictions_sha256': binding['score']['predictions_sha256'], 'scoring_manifest_sha256': binding['score']['artifacts_sha256'], 'n_rows': 4, 'scoring_dir': str(score), 'input_format': mode, 'input_sha256': input_sha}
+    (root / 'pipeline.json').write_text(json.dumps(state))
+    manifest(root)
+    batch = SimpleNamespace(summary={'model_type': 'nn', 'target_unit': 'MPa', 'nn_binding': binding}, record={'artifact_dir': str(score)})
+    config = SimpleNamespace(pipeline_dir=root, expected_pipeline_id=root.name, expected_pipeline_manifest_sha256=sha(root / 'pipeline_manifest.json'), target_unit='MPa')
+    return (root, state, batch, config)
+
+def manifest(root):
+    entries = {p.relative_to(root).as_posix(): {'sha256': sha(p), 'bytes': p.stat().st_size} for p in root.rglob('*') if p.is_file() and p.name != 'pipeline_manifest.json'}
+    (root / 'pipeline_manifest.json').write_text(json.dumps({'schema_version': 1, 'files': entries}))
