+    imported = run(trained['engine'], 'labels', request, output_root=tmp_path / 'labels', check_only=False)
+    labelled = NNMonitorConfig(**common, reference_id=ref['reference_id'], label_import_id=imported['label_import_id'], as_of='2026-01-03T00:00:00+00:00', min_rows=2, min_labelled=2, rmse_warning=1.0, abs_bias_warning=0.1)
+    assessed = run(trained['engine'], 'monitor', labelled, output_root=tmp_path / 'labelled_monitoring', check_only=False)
+    saved = load_assessment(tmp_path / 'project.db', assessed['monitoring_id'])
