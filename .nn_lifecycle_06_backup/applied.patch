+    second_common = {**common, 'pipeline_dir': Path(second['artifact_dir']), 'expected_pipeline_id': second['pipeline_id'], 'expected_pipeline_manifest_sha256': digest(Path(second['artifact_dir']) / 'pipeline_manifest.json'), 'scoring_batch_id': second['scoring_batch_id']}
+    second_monitor = NNMonitorConfig(**second_common, reference_id=ref['reference_id'], as_of='2026-01-03T00:00:00+00:00')
+    assert run(trained['engine'], 'monitor', second_monitor, output_root=tmp_path / 'second_monitoring', check_only=True)['ready']
+    bad = reference.model_copy(update={'expected_pipeline_manifest_sha256': 'f' * 64})
+    with pytest.raises(ValueError):
