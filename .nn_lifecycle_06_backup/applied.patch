+    t = pd.read_csv(template['template_path'])
+    assert t.y_true.isna().all() and t.observed_at.isna().all() and t.eligible_at.isna().all()
+    config = NNMonitorConfig(**common, reference_id=ref['reference_id'], as_of='2026-01-03T00:00:00+00:00')
+    monitored = run(trained['engine'], 'monitor', config, output_root=tmp_path / 'monitoring', check_only=False)
