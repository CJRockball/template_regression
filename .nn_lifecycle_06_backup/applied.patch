+@pytest.mark.parametrize('field,value', [('status', 'failed'), ('stage', 'export'), ('target_unit', 'wrong'), ('release_id', 'wrong'), ('evaluation_id', 'wrong'), ('calibration_id', 'other'), ('scoring_batch_id', 'other'), ('predictions_computed', False), ('labels_loaded', True), ('evaluation_executed', True), ('release_built', True), ('n_rows', 99)])
