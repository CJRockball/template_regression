+    assert saved['summary']['assessment_scope']['performance_status'] == 'assessed_mature_labelled_subset'
+    assert perf['score_metrics']['y_pred_release']['rmse'] == pytest.approx(np.sqrt(1.5))
+    assert perf['score_metrics']['y_pred_release']['bias'] == pytest.approx(-0.5)
+    assert any((r['metric'] == 'bias' for r in metric_rows(perf)))
+    if corrected:
+        assert perf['interval_metrics']
+    payload = monitoring_payload(tmp_path / 'project.db', assessed['monitoring_id'])
+    assert len(payload) == 10 and 'unavailable' not in payload[0].lower() and ('NN assessment scope' in payload[8])
+    assert bundle_bytes(saved, assessed['monitoring_id'])[:2] == b'PK'
+    partial = labels.copy()
+    partial.loc[0, 'eligible_at'] = '2026-01-10T00:00:00+00:00'
+    partial.loc[1, 'observed_at'] = '2026-01-10T00:00:00+00:00'
+    partial.loc[2, 'y_true'] = np.nan
+    partial.loc[2, 'observed_at'] = None
+    partial_path = tmp_path / 'synthetic_partial.csv'
+    partial.to_csv(partial_path, index=False)
+    revised_labels = NNLabelConfig(**common, input_path=partial_path, source='Synthetic partial only', outcome_definition='Synthetic residual arithmetic', sampling='selected', supersedes_label_import_id=imported['label_import_id'])
+    partial_id = run(trained['engine'], 'labels', revised_labels, output_root=tmp_path / 'partial_labels', check_only=False)['label_import_id']
+    partial_config = NNMonitorConfig(**common, reference_id=ref['reference_id'], label_import_id=partial_id, as_of='2026-01-03T00:00:00+00:00', min_rows=2, min_labelled=2, rmse_warning=0.0, abs_bias_warning=0.0)
+    partial_mon = run(trained['engine'], 'monitor', partial_config, output_root=tmp_path / 'partial_monitoring', check_only=False)
+    partial_view = load_assessment(tmp_path / 'project.db', partial_mon['monitoring_id'])
+    assert partial_view['performance']['n_evaluated'] == 1
+    assert partial_view['performance']['mature_label_coverage'] == pytest.approx(1 / 3)
+    assert partial_view['summary']['assessment_scope']['performance_status'] == 'not_assessed_insufficient_outcomes'
+    assert not any((f['rule'] in {'rmse_warning', 'mae_warning', 'abs_bias_warning', 'interval_undercoverage'} for f in partial_view['findings']))
