+    pipeline_hash = digest(directory / 'pipeline_manifest.json')
+    common = {'pipeline_dir': directory, 'expected_pipeline_id': pipeline['pipeline_id'], 'expected_pipeline_manifest_sha256': pipeline_hash, 'scoring_batch_id': pipeline['scoring_batch_id'], 'target_unit': 'synthetic_units'}
+    prediction = pd.read_parquet(pipeline['predictions_path'])
+    before = digest(tmp_path / 'project.db')
