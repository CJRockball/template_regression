+
+@pytest.mark.parametrize('case,expected', [('none', 'unknown_no_labels'), ('zero', 'not_assessed_no_mature_observed_outcomes'), ('support', 'not_assessed_insufficient_outcomes'), ('coverage', 'not_assessed_label_coverage'), ('selected', 'not_assessed_selected_or_unknown_sampling'), ('good', 'assessed_mature_labelled_subset')])
