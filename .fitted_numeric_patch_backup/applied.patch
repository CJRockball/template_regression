+@pytest.mark.parametrize("engineered", [False, True])
+@pytest.mark.parametrize("predictor_kind", ["final", "cv_mean"])
+def test_fitted_regression_end_to_end(tmp_path, monkeypatch, engineered, predictor_kind):
